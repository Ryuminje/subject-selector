# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env* 는 전부 gitignore 됩니다)

# ─────────────────────────────────────────────────────────────
# Prisma / PostgreSQL
# ─────────────────────────────────────────────────────────────
# 스키마 provider 가 postgresql 이므로 반드시 postgresql:// 형식이어야 합니다.
# (예전에는 SQLite 였지만 2026-07-21 에 Postgres 로 이전했습니다.)
#
#   같은 랜 안(집/학교)  : postgresql://USER:PASSWORD@192.168.0.21:55432/DBNAME
#   외부(Vercel 등)      : postgresql://USER:PASSWORD@fbalswp.duckdns.org:55432/DBNAME
#
# 로그인이 필요한 "쌤스 헬퍼"(/apps/schedule-helper) 계열만 DB 를 씁니다.
# 허브 · 수강신청 도우미 · 시험 시간표 도우미는 DB 없이 동작하므로, 그 화면만
# 볼 목적이라면 아래처럼 접속되지 않는 더미 값을 넣어도 `next dev` 가 뜹니다.
# (형식이 postgresql:// 이기만 하면 됩니다 — 값이 아예 없으면 부팅 자체가 실패합니다.)
DATABASE_URL="postgresql://user:pass@localhost:5432/dev"

# ─────────────────────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────────────────────
# `npx auth secret` 으로 생성하세요 (아무 긴 랜덤 문자열이어도 됩니다).
# 로컬용과 배포용 값은 반드시 다르게 쓰세요.
BETTER_AUTH_SECRET=""

# 앱이 자기 자신을 가리키는 주소입니다.
# 배포 환경에서는 배포 URL(https://subject-selector.vercel.app)로 바꾸세요.
BETTER_AUTH_URL="http://localhost:3000"
