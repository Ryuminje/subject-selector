// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 학교 하나 = 테넌트 하나

model School {
  id       String @id @default(cuid())
  name     String
  joinCode String @unique

  // 업로드된 시간표 원본 (teachers/days/periods/tableData 형태의 JSON — ScheduleData 참고)
  scheduleData       String?
  scheduleUploadedAt DateTime?

  // 전체 교사 공통 협의회 불가 요일/교시 (JSON: Record<day, number[]>)
  globalMeetingBlocks String @default("{}")

  // 교과군 그룹 목록 (JSON: string[]) — 교사 목록 관리 화면에서 관리자가 추가/삭제
  departmentGroups String @default("[\"국어\",\"영어\",\"수학\",\"사회\",\"과학\"]")

  // 교체 자체가 금지된 과목명 목록 (JSON: string[]) — 시간 이동(교체)이 아예 불가능한 과목
  blockedSubjects String @default("[]")

  // 교체·대강 모두 완전히 금지된 교사명 목록 (JSON: string[])
  blockedTeachers String @default("[]")

  // 연수 이수증 수거용 Gemini API 키 — 관리자가 등록하면 같은 학교 전원이 사용 (평문 저장, joinCode와 동일한 신뢰 수준)
  geminiApiKey String?

  createdAt DateTime @default(now())

  teachers                 Teacher[]
  trainingTitles           TrainingTitle[]
  trainingCertificates     TrainingCertificate[]
  signSessions             SignSession[]
  certificateRosterExtras  CertificateRosterExtra[]
  certificateRosterPresets CertificateRosterPreset[]
  assistantBots            AssistantBot[]
  meetingPresets           MeetingPreset[]
  makeupBatches            MakeupBatch[]
}

// 협의회 시간 찾기에서 자주 함께 잡는 교사 묶음("2학년부", "과학과" 같은).
//
// 연수 이수증의 CertificateRosterPreset과 달리 **학교 공용이 아니라 계정별**입니다 —
// 협의회 상대는 사람마다 다르므로 사용자가 "개개인이 설정"으로 요구했습니다.
// 그래서 조회·수정·삭제 모두 세션의 userId로만 걸러집니다.
model MeetingPreset {
  id String @id @default(cuid())

  // better-auth가 관리하는 User.id. **일부러 @relation을 걸지 않았습니다** —
  // User 모델은 `npx auth generate`가 통째로 다시 쓰기 때문에 관계 필드를 달면
  // 다음 생성 때 사라집니다(User.schoolId/teacherId와 같은 이유).
  // 계정을 지울 때 이 행도 같이 지우는 일은 members DELETE 라우트가 직접 합니다.
  userId String

  // 교사 이름은 학교 안에서만 뜻이 있으므로 학교로도 묶어둡니다.
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name     String
  teachers String // JSON string[] — 고른 순서를 그대로 보존

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

// 이름 붙여 저장하는 교체·보강 작업 세트(수업교체 도우미 트레이의 서버판).
//
// 여러 선생님 몫을 한 번에 손보다 보면 시간이 걸려서, 트레이(브라우저 메모리)에만 두면
// 새로고침·다른 날 이어서 하기가 안 됩니다. 그래서 트레이 내용 전체(MakeupEntry[] +
// 결강 주간 기준일)를 이름을 붙여 저장해 두고 언제든 불러와 이어서 고칠 수 있게 합니다.
//
// MeetingPreset과 마찬가지로 **개인 전용**입니다(작성자 본인만 보고 불러올 수 있음) —
// 여러 사람이 나눠 쓰는 기능이 아니라 한 사람이 혼자 여러 선생님 몫을 처리하는
// 용도라고 확인했습니다. 그래서 조회·수정·삭제 모두 세션의 userId로만 걸러집니다.
model MakeupBatch {
  id String @id @default(cuid())

  // better-auth가 관리하는 User.id. MeetingPreset과 같은 이유로 @relation을 걸지 않습니다
  // (User 모델은 `npx auth generate`가 통째로 다시 씁니다). 계정을 지울 때 이 행도 같이
  // 지우는 일은 members DELETE 라우트가 직접 합니다.
  userId String

  // 교사 이름은 학교 안에서만 뜻이 있으므로 학교로도 묶어둡니다.
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String

  // JSON string — MakeupEntry[] (kind, absentTeacher, absent 슬롯, partnerTeacher,
  // exchange 슬롯?, absentDateOverride?, exchangeDateOverride?) 그대로 직렬화합니다.
  entries String

  // 결강 주간 기준일(YYYY-MM-DD) — 트레이의 useMakeupTray.baseDate와 같은 값. 비어 있을 수
  // 있어 기본값을 빈 문자열로 둡니다(불러올 때 마운트 후 채우는 오늘 날짜로 대체됨).
  baseDate String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

// 시간표에 등장하는 교사 한 명 (로그인 계정 유무와 무관하게 존재 — 업로드 시 이름으로 자동 upsert)

model Teacher {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String

  // 교과군 (기존 "설정" 시트 I~J열 대체)
  department String?

  // 고정 교체 불가 요일/교시 (기존 "설정" 시트 A~C열 대체, JSON: Record<day, number[]>)
  fixedBlockDays String @default("{}")

  // 오늘 결근/출장 등 임시 설정 (기존 브라우저 localStorage 대체, 학교 전체 공유, JSON: Record<day, number[]>)
  tempBlockDays String @default("{}")

  @@unique([schoolId, name])
}

// 연수 이수증 수거 — 담당 선생님이 등록한 연수 제목. 등록된 연수만 전체 교사가 제출할 수 있고,
// 제출 현황(일괄확인)은 그 연수를 등록한 담당 선생님과 관리자만 조회할 수 있습니다.

model TrainingTitle {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title             String
  registeredByName  String  // 담당 선생님 이름 — 제출 시점과 동일하게 session 기준으로 서버가 채움
  rosterSnapshot    String? // JSON string[] — 이 연수 전용 참여명단. null이면 getCertificateRoster() 기본값으로 대체
  category          String  @default("certificate") // "certificate"(이수증 수거) | "sign"(서명 연수/QR서명) — 어느 메뉴/선택창에 노출될지 구분
  createdAt         DateTime @default(now())

  @@unique([schoolId, title])
  @@index([schoolId, registeredByName])
}

// 연수 이수증 수거 — 제출된 이수증 한 건 (teacherName은 자유 입력이 아니라 제출 시점 session.user 기준으로 서버가 채움)

model TrainingCertificate {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherName   String
  trainingTitle String
  number        String // 이수번호
  institution   String // 이수기관
  certDate      String // 이수날짜 (Gemini 추출값, 자유 텍스트로 유지)

  fileName  String
  mimeType  String
  fileBytes Bytes // Postgres bytea — 원본 파일 바이트

  createdAt DateTime @default(now())

  @@index([schoolId, teacherName])
  @@index([schoolId, trainingTitle])
}

// 연수 이수증 수거 — QR 서명 세션 (단일 연수 또는 복수 연수 그룹)

model SignSession {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  trainingTitles   String  // JSON string[] — 단일 1개, 복수연수 2개 이상
  rosterSnapshot   String  // JSON string[] — 세션 생성 시점 명단 스냅샷(합집합). 프리셋/전체 기본 명시 선택 시 그 명단, 아니면 titleRosters 합집합
  titleRosters     String? // JSON Record<title, string[]> — 세션 생성 시점 "연수별" 명단 스냅샷. roster를 명시적으로 지정(전체 기본/프리셋 선택)한 세션은 null 유지
  rosterPresetName String? // 이 세션 생성에 사용한 CertificateRosterPreset.name (없으면 "전체 명단" 기본 경로)
  locked           Boolean  @default(false)
  createdAt        DateTime @default(now())
  createdByUserId  String   // better-auth User.id (조회용, @relation 없음 — User 모델 손대지 않는 원칙)

  signatures SignSessionSignature[]

  @@index([schoolId, createdAt])
}

// 연수 이수증 수거 — 세션 내 교사 1명당 서명 1건
// (복수 연수 세션이어도 서명은 한 번만 — 그 서명이 세션의 모든 연수 제목에 동시 적용됨, 원본 Code.gs의
// submitSignature가 sheetNameList.forEach로 같은 서명 이미지를 모든 연수 시트에 동시 기록하던 것과 동일한 동작)

model SignSessionSignature {
  id        String      @id @default(cuid())
  sessionId String
  session   SignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  teacherName  String
  signaturePng Bytes

  signedAt DateTime @default(now())

  @@unique([sessionId, teacherName])
  @@index([sessionId])
}

// 연수 이수증 수거 — 시간표(Teacher)에 없는 인원(행정직원 등)을 일괄확인/QR 서명 명단에만 추가로 포함시키기 위한 명단.
// 시간표 교체 도우미(SwapTab)는 School.scheduleData.teachers를 기준으로 하므로 이 명단은 영향을 주지 않습니다.

model CertificateRosterExtra {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String
  addedBy   String // 추가한 관리자 이름 (참고용 — 삭제 권한은 관리자 전원에게 있음)
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
}

// 연수 이수증 수거 — 용도별로 이름 붙여 저장해두고 재사용하는 명단 프리셋(예: "전체 교직원", "부장단만").
// names는 드래그 앤 드롭으로 정한 순서를 그대로 보존하는 JSON string[] — 재정렬 없음, 저장된 순서가 곧 서명부 순서.

model CertificateRosterPreset {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String
  names     String // JSON string[] — 순서 유지된 이름 목록
  createdBy String // 만든 관리자 이름 (참고용)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, updatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// 업무 AI 파트너 — 선생님이 자기 업무 자료를 올려두고 그 자료만 근거로 답하는 챗봇.
// "업무 하나 = 챗봇 하나 = 자료함 하나"가 원칙이라, 한 계정이 챗봇을 여러 개 만들고
// 각 챗봇은 자기 자료함(AssistantDocument)만 검색합니다 — 예산 자료가 학적 질문에
// 섞여 들어오지 않게 하는 것이 답변 정확도의 핵심입니다.
// ─────────────────────────────────────────────────────────────────────────────

model AssistantBot {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // 만든 사람이 곧 관리자 — 이수증 수거의 canManage 규칙과 같은 모델입니다.
  ownerUserId String
  ownerName   String

  name    String
  tagline String? // 목록/헤더에 한 줄로 붙는 소개
  emoji   String  @default("🤖")
  accent  String  @default("amber") // 아바타 색 — 허브 palette와 같은 이름(amber/rose/emerald/sky/violet)
  persona String? // 역할·말투에 대한 추가 지시. 근거 규칙은 서버가 항상 덧붙이므로 여기서 못 덮어씁니다.

  starters String @default("[]") // JSON string[] — 대화창 아래 추천 질문 칩

  // "private" = 만든 사람만, "school" = 같은 학교 전원이 대화 가능(편집은 여전히 만든 사람만).
  // 1단계에서는 서버가 항상 "private"으로 고정하고, 2단계에 값만 열어주면 됩니다.
  visibility String @default("private")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents AssistantDocument[]
  threads   AssistantThread[]

  @@index([schoolId, ownerUserId])
}

// 챗봇 자료함에 올라간 파일 1개. 원본 바이트는 TrainingCertificate와 같은 방식으로 보관합니다
// (Postgres bytea) — 나중에 "원문 열어보기"를 붙일 수 있도록.

model AssistantDocument {
  id    String       @id @default(cuid())
  botId String
  bot   AssistantBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  fileName  String
  mimeType  String
  byteSize  Int
  fileBytes Bytes

  // 분석 파이프라인 상태. Vercel 함수가 60초에서 끊기므로 한 번에 다 끝내지 않고
  // /ingest를 여러 번 호출해 조금씩 진행합니다 — 그 진행 상황이 그대로 화면에 표시됩니다.
  status        String  @default("pending") // pending | processing | ready | failed
  error         String? // 실패 사유를 그대로 사용자에게 보여줍니다(예: 스캔본이라 글자 없음)
  pageCount     Int?
  chunkCount    Int     @default(0)
  embeddedCount Int     @default(0)

  createdAt DateTime @default(now())

  chunks AssistantChunk[]

  @@index([botId])
}

// 문서를 검색 단위로 쪼갠 조각. embedding은 pgvector 타입이라 Prisma가 직접 다루지 못해
// Unsupported로 선언하고, 넣고 빼는 건 assistant/search.ts의 raw SQL만 담당합니다.

model AssistantChunk {
  id         String            @id @default(cuid())
  documentId String
  document   AssistantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // 검색할 때 챗봇 단위로 바로 거르기 위한 비정규화 컬럼 (join 한 번을 아낍니다 —
  // DB가 NAS 원격이라 왕복/작업량을 줄이는 게 중요합니다)
  botId String

  ordinal Int // 문서 안에서의 순서
  page    Int? // 근거 표시에 쓰는 페이지 번호 (없으면 null)
  content String

  embedding Unsupported("vector(768)")?

  @@index([botId])
  @@index([documentId])
}

// 대화 1건. 참고 이미지처럼 이어지는 대화를 유지하려면 스레드가 있어야 합니다.

model AssistantThread {
  id    String       @id @default(cuid())
  botId String
  bot   AssistantBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  userId String // better-auth User.id — 공개 챗봇이어도 대화는 사람마다 따로입니다
  title  String @default("새 대화")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AssistantMessage[]

  @@index([botId, userId, updatedAt])
}

model AssistantMessage {
  id       String          @id @default(cuid())
  threadId String
  thread   AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role      String // "user" | "model"
  content   String
  citations String @default("[]") // JSON [{documentId, fileName, page}] — 답변 아래 근거 칩

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// 로그인 계정(user/session/account/verification)은 better-auth CLI(`npx auth generate`)가
// 이 파일에 직접 추가합니다 — 이 아래에 생성된 모델은 손으로 수정하지 말고,
// schoolId/role/teacherId 같은 앱 전용 필드는 src/lib/auth.ts의 user.additionalFields로 정의하세요.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String
  schoolId      String
  teacherId     String?
  loginId       String? // 이메일이 아닌 아이디 로그인용 (관리자 발급 계정 전용), 학교 안에서만 유일
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@unique([schoolId, loginId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
